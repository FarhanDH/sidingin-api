{
    "name": "sidingin-api",
    "version": "0.0.1",
    "description": "cdingin api to be used by cdingin app",
    "author": "farhandh",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli -d src/core/database/data-source.ts",
        "migration:create": "cross-var ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli migration:create src/core/database/migrations/$npm_config_name",
        "migration:generate": "cross-var npm run typeorm -- migration:generate ./src/core/database/migrations/$npm_config_name -p",
        "migration:run": "npm run typeorm migration:run",
        "migration:revert": "npm run typeorm migration:revert",
        "migration:show": "npm run typeorm migration:show",
        "migration:sync": "npm run typeorm schema:sync",
        "migration:drop": "npm run typeorm schema:drop",
        "seed:config": "ts-node ./node_modules/typeorm-seeding/dist/cli.js config",
        "seed:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm-seeding/dist/cli.js seed",
        "seed": "ts-node -r tsconfig-paths/register node_modules/typeorm-extension/dist/cli/index.js seed -d src/core/database/data-source.ts",
        "db:diagram": "ts-node ./node_modules/typeorm-uml/bin/run ormconfig.js --download diagram.png --format png"
    },
    "dependencies": {
        "@golevelup/nestjs-rabbitmq": "^9.1.1",
        "@grpc/grpc-js": "^1.14.6",
        "@grpc/proto-loader": "^0.8.1",
        "@nestjs-modules/mailer": "^2.0.2",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/common": "^10.0.0",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^10.0.0",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/mapped-types": "*",
        "@nestjs/microservices": "^10.0.0",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/swagger": "^11.2.3",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/typeorm": "^11.0.0",
        "amqp-connection-manager": "^5.0.1",
        "amqplib": "^2.2.0",
        "axios": "^1.11.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "cookie-parser": "^1.4.7",
        "cross-var": "^1.1.0",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.0",
        "ejs": "^3.1.10",
        "express": "^5.1.0",
        "handlebars": "^4.7.8",
        "haversine-distance": "^1.2.4",
        "hbs": "^4.2.0",
        "midtrans-client": "^1.4.3",
        "pg": "^8.16.3",
        "pusher": "^5.2.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.1",
        "short-unique-id": "^5.3.2",
        "typeorm": "^0.3.25",
        "typeorm-extension": "^3.7.1",
        "typeorm-seeding": "^1.6.1",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@flydotio/dockerfile": "^0.7.15",
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@swc/cli": "^0.7.8",
        "@swc/core": "^1.12.11",
        "@types/amqplib": "^0.10.8",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.2",
        "@types/midtrans-client": "^1.4.0",
        "@types/node": "^20.3.1",
        "@types/supertest": "^6.0.0",
        "@types/web-push": "^3.6.4",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.5.0",
        "prettier": "^3.0.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typeorm-uml": "^1.6.5",
        "typescript": "^5.1.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
